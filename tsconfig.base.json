{
  "compilerOptions": {
    "types": ["node"],
    // Every package compiles for one target: the newest ES version that both
    // Node.js 24 on AWS Lambda and current evergreen browsers run.
    "target": "ES2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "declaration": true,
    // We use esbuild to transpile and bundle the code,
    // so we only need the declaration files.
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
